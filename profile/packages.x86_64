#
# BurnBench live ISO package list (x86_64)
#

# --- base system / boot ---
base
linux
linux-firmware
mkinitcpio
mkinitcpio-archiso
amd-ucode
intel-ucode
grub
syslinux
efibootmgr
memtest86+
memtest86+-efi

# --- firmware for common laptop/desktop hardware ---
sof-firmware
wireless-regdb

# --- networking (NetworkManager owns wifi; resolved does DNS) ---
networkmanager
wpa_supplicant
iw
usbutils

# --- desktop: KDE Plasma (X11 session) ---
xorg-server
xorg-xinit
mesa
xf86-video-amdgpu
xf86-video-vesa
plasma-desktop
plasma-workspace
powerdevil
plasma-pa
plasma-nm
konsole
dolphin
systemsettings
qt6-tools

# --- audio (PipeWire stack; paplay comes with libpulse) ---
pipewire
pipewire-pulse
pipewire-alsa
wireplumber
libpulse
alsa-utils
alsa-ucm-conf

# --- burn-in & benchmarking tools ---
stress-ng
gmp
dmidecode
lm_sensors
hdparm
smartmontools
gsmartcontrol
gnome-disk-utility
bonnie++
hardinfo
memtester
inxi
lshw
v4l-utils

# --- camera viewer (lighter than cheese) ---
guvcview

# --- built from aur/ by build.sh into the local repo ---
gst
systester

# --- mic level meter (Stage 3b) ---
pavucontrol

# --- misc QOL ---
nano
less
htop
mpg123
fastfetch
kate
wmctrl
kwin-x11
