#
# BurnBench live ISO package list (x86_64)
#

# --- base system / boot ---
base
linux
linux-firmware
mkinitcpio
mkinitcpio-archiso
amd-ucode
intel-ucode
grub
syslinux
efibootmgr
memtest86+
memtest86+-efi

# --- firmware for common laptop/desktop hardware ---
sof-firmware
wireless-regdb

# --- networking (NetworkManager owns wifi; resolved does DNS) ---
networkmanager
wpa_supplicant
iw
usbutils

# --- desktop: Hyprland (Wayland tiling compositor) ---
hyprland
kitty
swaybg
mako
libnotify
polkit
xdg-desktop-portal-gtk
vulkan-intel
vulkan-radeon
pavucontrol

# --- audio (PipeWire stack; paplay comes with libpulse) ---
pipewire
pipewire-pulse
pipewire-alsa
wireplumber
libpulse
alsa-utils

# --- burn-in & benchmarking tools ---
stress-ng
gmp
dmidecode
lm_sensors
hdparm
smartmontools
gsmartcontrol
gnome-disk-utility
bonnie++
hardinfo
memtester
inxi
lshw
v4l-utils

# --- camera viewer (lighter than cheese) ---
guvcview

# --- built from aur/ by build.sh into the local repo ---
gst
systester

# --- misc QOL ---
nano
less
htop
mpg123
fastfetch
