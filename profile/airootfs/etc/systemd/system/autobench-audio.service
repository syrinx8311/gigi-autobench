[Unit]
Description=AutoBench: unmute all audio controls at 85%
Wants=sound.target
After=sound.target

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'for ctl in $(amixer scontrols | sed -n "s/.*'\''\(.*\)'\''.*/\1/p"); do amixer sset "$ctl" 85% unmute >/dev/null; done'
RemainAfterExit=yes

[Install]
WantedBy=sound.target
